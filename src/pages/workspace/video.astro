---
import BackofficeLayout from '../../layouts/BackofficeLayout.astro';
import { getFullStudioSnapshot } from '../../lib/analytics';
import { formatRupiah, formatShortDate, VIDEO_TASK_LABELS } from '../../lib/format';

const snap = await getFullStudioSnapshot();
const videoEditor = snap.users.find((u) => u.role === 'VIDEO_EDITOR');

const teaserPending = snap.videoTasks.filter((t) => t.teaserStatus !== 'READY');
const activeMain = snap.videoTasks.filter((t) => t.mainStatus !== 'FINALIZED');
const finalizedMain = snap.videoTasks.filter((t) => t.mainStatus === 'FINALIZED');
const unpaidIncentive = finalizedMain
  .filter((t) => !t.incentivePaid)
  .reduce((s, t) => s + t.incentiveFee, 0);
---

<BackofficeLayout
  title={`Workspace Editor Video — ${videoEditor?.name || 'Kevin Mahendra'}`}
  subtitle="1 Orang Dedicated In-House Video Editor • Prioritas Teaser H+2, Cinematic Film & Timestamp Revision"
  activeNav="video-editor"
>
  <!-- Capacity & Compensation Strip -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    <div class="bg-white border border-black/12 p-5">
      <p class="eyebrow-label text-red-800">Prioritas 1: Teaser Reels (H+2)</p>
      <p class="text-3xl font-normal mt-1">{teaserPending.length} Antrean</p>
      <p class="text-[11px] text-[#5e5d59] mt-1">Wajib didahulukan untuk kebutuhan sosmed klien</p>
    </div>
    <div class="bg-white border border-black/12 p-5">
      <p class="eyebrow-label text-[#5e5d59]">Prioritas 2: Video Utama Aktif</p>
      <p class="text-3xl font-normal mt-1">{activeMain.length} Project</p>
      <p class="text-[11px] text-[#5e5d59] mt-1">Cinematic Highlight & Full Documentary</p>
    </div>
    <div class="bg-white border border-black/12 p-5">
      <p class="eyebrow-label text-emerald-800">Master 4K Selesai</p>
      <p class="text-3xl font-normal mt-1 text-emerald-900">{finalizedMain.length} Project</p>
      <p class="text-[11px] text-[#5e5d59] mt-1">Sudah diunggah ke Google Drive Studio</p>
    </div>
    <div class="bg-[#181817] text-white p-5">
      <p class="eyebrow-label text-white/55">Gaji Pokok + Insentif Belum Cair</p>
      <p class="text-2xl font-normal tabular-nums mt-1">
        {formatRupiah((videoEditor?.baseMonthlySalary || 5000000) + unpaidIncentive)}
      </p>
      <p class="text-[11px] text-white/60 mt-1">
        Gaji {formatRupiah(videoEditor?.baseMonthlySalary || 5000000)} + Komisi {formatRupiah(unpaidIncentive)}
      </p>
    </div>
  </div>

  <!-- Video Production Cards -->
  <div class="space-y-5">
    <h2 class="text-lg font-medium">Antrean Editing Teaser, Cinematic Highlight & Revisi Timestamp</h2>

    {
      snap.videoTasks.map((vt) => {
        const bk = snap.bookings.find((b) => b.id === vt.bookingId);
        if (!bk) return null;
        const ws = JSON.parse(bk.worksheetJson || '{}');
        const revs: Array<{ id: string; timecode: string; note: string; done: boolean }> = JSON.parse(
          vt.timestampRevisionsJson || '[]'
        );

        return (
          <div class="bg-white border border-black/15 p-6 space-y-5">
            <div class="flex flex-wrap items-start justify-between gap-4 border-b border-black/10 pb-4">
              <div class="space-y-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="font-mono text-xs font-semibold bg-[#f3f2ee] px-2.5 py-0.5">{bk.bookingCode}</span>
                  <span
                    class:list={[
                      'text-[10px] font-semibold uppercase px-2 py-0.5',
                      vt.teaserStatus === 'READY' ? 'bg-emerald-100 text-emerald-900' : 'bg-amber-100 text-amber-900',
                    ]}
                  >
                    Teaser 60s: {vt.teaserStatus}
                  </span>
                  {!bk.allowPortfolioPublish && (
                    <span class="bg-red-900 text-white text-[10px] font-bold uppercase px-2.5 py-0.5">
                      🔒 PRIVATE — JANGAN UPLOAD REELS KE TIKTOK/IG STUDIO
                    </span>
                  )}
                </div>
                <h3 class="text-xl font-normal">{bk.eventTitle}</h3>
                <p class="text-xs text-[#5e5d59]">
                  Lagu Referensi Klien: <strong class="text-[#121212]">{ws.songReference || 'Bebas kurasi editor'}</strong>{' '}
                  • SLA Master: {formatShortDate(vt.mainDueDate)} • Insentif: <strong>{formatRupiah(vt.incentiveFee)}</strong>
                </p>
              </div>

              <span class="px-3 py-1.5 bg-[#181817] text-white text-[10px] uppercase tracking-[0.14em] font-semibold">
                {VIDEO_TASK_LABELS[vt.mainStatus] || vt.mainStatus}
              </span>
            </div>

            {/* Timestamped Revision Checklist */}
            {revs.length > 0 && (
              <div class="bg-[#f6f4ef] border border-black/10 p-4 space-y-2.5 text-xs">
                <p class="font-semibold uppercase tracking-wider text-[10px] text-[#5e5d59]">
                  Checklist Revisi Timestamp dari Klien ({vt.revisionCount}/2x Kuota Revisi)
                </p>
                {revs.map((rv) => (
                  <div class="bg-white p-3 border border-black/10 flex items-center justify-between gap-3">
                    <div>
                      <span class="font-mono font-bold text-[#121212] mr-2">[{rv.timecode}]</span>
                      <span class={rv.done ? 'line-through text-[#8c8b85]' : ''}>{rv.note}</span>
                    </div>
                    <form method="POST" action="/api/actions">
                      <input type="hidden" name="action" value="toggle_video_revision_item" />
                      <input type="hidden" name="taskId" value={vt.id} />
                      <input type="hidden" name="revId" value={rv.id} />
                      <input type="hidden" name="redirectTo" value="/workspace/video" />
                      <button
                        type="submit"
                        class:list={[
                          'px-3 py-1 text-[10px] uppercase font-semibold border cursor-pointer',
                          rv.done
                            ? 'bg-emerald-100 text-emerald-900 border-emerald-300'
                            : 'bg-white text-[#121212] border-black/25',
                        ]}
                      >
                        {rv.done ? '✓ Selesai' : 'Tandai Selesai'}
                      </button>
                    </form>
                  </div>
                ))}
              </div>
            )}

            {/* Update Video Task Status & Delivery Links */}
            <form method="POST" action="/api/actions" class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end">
              <input type="hidden" name="action" value="update_video_task" />
              <input type="hidden" name="taskId" value={vt.id} />
              <input type="hidden" name="redirectTo" value="/workspace/video" />

              <div class="md:col-span-2">
                <label class="block text-[10px] uppercase tracking-wider text-[#5e5d59] mb-1">Status Teaser</label>
                <select name="teaserStatus" class="w-full px-2.5 py-2.5 border border-black/20 bg-white text-xs">
                  <option value="WAITING_FOOTAGE" selected={vt.teaserStatus === 'WAITING_FOOTAGE'}>Menunggu</option>
                  <option value="EDITING" selected={vt.teaserStatus === 'EDITING'}>Editing</option>
                  <option value="READY" selected={vt.teaserStatus === 'READY'}>Selesai</option>
                </select>
              </div>

              <div class="md:col-span-3">
                <label class="block text-[10px] uppercase tracking-wider text-[#5e5d59] mb-1">Status Video Utama</label>
                <select name="mainStatus" class="w-full px-2.5 py-2.5 border border-black/20 bg-white text-xs">
                  {Object.entries(VIDEO_TASK_LABELS).map(([k, lbl]) => (
                    <option value={k} selected={vt.mainStatus === k}>
                      {lbl}
                    </option>
                  ))}
                </select>
              </div>

              <div class="md:col-span-3">
                <label class="block text-[10px] uppercase tracking-wider text-[#5e5d59] mb-1">Link Preview Video</label>
                <input
                  type="text"
                  name="previewUrl"
                  value={vt.previewUrl}
                  placeholder="https://drive.google.com/..."
                  class="w-full px-3 py-2.5 border border-black/20 bg-white text-xs"
                />
              </div>

              <div class="md:col-span-4 flex gap-2">
                <div class="flex-1">
                  <label class="block text-[10px] uppercase tracking-wider text-[#5e5d59] mb-1">
                    Folder Google Drive Master 4K
                  </label>
                  <input
                    type="text"
                    name="finalGdriveUrl"
                    value={vt.finalGdriveUrl}
                    placeholder="https://drive.google.com/..."
                    class="w-full px-3 py-2.5 border border-black/20 bg-white text-xs"
                  />
                </div>
                <button type="submit" class="btn-sq-black !py-2.5 !px-4 !text-[10px] shrink-0 cursor-pointer">
                  Simpan
                </button>
              </div>
            </form>
          </div>
        );
      })
    }
  </div>
</BackofficeLayout>
