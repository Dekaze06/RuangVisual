---
import EditorialLayout from '../layouts/EditorialLayout.astro';
import { getFullStudioSnapshot } from '../lib/analytics';
import { formatShortDate } from '../lib/format';

const snap = await getFullStudioSnapshot();
const publicWorks = snap.bookings.filter((b) => b.allowPortfolioPublish);
const privateCount = snap.bookings.filter((b) => !b.allowPortfolioPublish).length;
const testimonials = snap.bookings.filter((b) => b.testimonialText);
---

<EditorialLayout title="Portofolio & Cerita Klien — Ruang Visual" headerTheme="light">
  <section class="bg-[#f6f4ef] py-20 md:py-28 border-b border-black/10">
    <div class="max-w-[1380px] mx-auto px-5 md:px-10 grid grid-cols-1 lg:grid-cols-12 gap-10 items-end">
      <div class="lg:col-span-7 space-y-5">
        <p class="eyebrow-label text-[#5e5d59]">Curated Visual Archive</p>
        <h1 class="display-xl text-[#121212]">
          Arsip momen<br />pilihan klien kami
        </h1>
      </div>
      <div class="lg:col-span-5 space-y-4">
        <p class="text-sm text-[#4a4945] leading-relaxed">
          Seluruh karya di halaman ini ditampilkan atas persetujuan resmi klien pada Kontrak Digital. Saat ini terdapat{' '}
          <strong>{privateCount} project berstatus Private Session</strong> yang disembunyikan otomatis demi menghormati
          privasi klien.
        </p>
        <a href="/booking" class="btn-sq-black">Abadikan Acara Anda →</a>
      </div>
    </div>
  </section>

  <!-- Portfolio Editorial Stories -->
  <section class="bg-white py-20">
    <div class="max-w-[1380px] mx-auto px-5 md:px-10 space-y-20">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        {
          publicWorks.map((item) => {
            const gal = snap.galleries.find((g) => g.bookingId === item.id);
            return (
              <article id={item.bookingCode} class="space-y-5 group">
                <div class="aspect-[4/3] overflow-hidden bg-[#181817] border border-black/10 relative">
                  <img
                    src={item.coverImage}
                    alt={item.eventTitle}
                    class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                  />
                  <span class="absolute top-4 left-4 bg-white px-3 py-1 text-[10px] uppercase tracking-[0.15em] font-semibold">
                    {item.categorySlug}
                  </span>
                </div>
                <div class="flex items-start justify-between gap-4 border-b border-black/10 pb-5">
                  <div>
                    <h2 class="text-2xl font-normal tracking-[-0.02em]">{item.eventTitle}</h2>
                    <p class="text-xs text-[#5e5d59] mt-1">
                      {item.venueName}, {item.venueCity} • {formatShortDate(item.eventDate)}
                    </p>
                  </div>
                  {gal && (
                    <a href={`/galeri/${gal.slug}`} class="btn-sq-outline-dark !py-2 !px-3.5 !text-[10px] shrink-0">
                      Buka Galeri ↗
                    </a>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>

      <!-- Verified Client Testimonials -->
      {
        testimonials.length > 0 && (
          <div class="bg-[#d5d2e2] p-8 md:p-14 space-y-8">
            <p class="eyebrow-label text-[#121212]/65">Ulasan Klien Terverifikasi</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              {testimonials.map((t) => (
                <blockquote class="bg-white p-8 border border-black/10 space-y-4">
                  <div class="text-xs tracking-widest">{'★'.repeat(t.testimonialRating || 5)}</div>
                  <p class="text-base leading-relaxed text-[#121212]">"{t.testimonialText}"</p>
                  <footer class="text-xs text-[#5e5d59] uppercase tracking-[0.12em] pt-2 border-t border-black/10">
                    <strong class="text-[#121212]">{t.clientName}</strong> — {t.eventTitle}
                  </footer>
                </blockquote>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>
</EditorialLayout>
