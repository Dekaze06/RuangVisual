---
import BackofficeLayout from '../../layouts/BackofficeLayout.astro';
import { getFullStudioSnapshot } from '../../lib/analytics';
import { formatRupiah, formatShortDate } from '../../lib/format';

const snap = await getFullStudioSnapshot();
---

<BackofficeLayout
  title="Manajemen Booking, Kontrak S&K & Verifikasi RAW"
  subtitle="Kendali seluruh pesanan klien, bukti tanda tangan kontrak digital, preferensi privasi, dan kelengkapan file kru."
  activeNav="bookings"
>
  <div class="space-y-6">
    {
      snap.bookings.map((bk) => {
        const pkg = snap.packages.find((p) => p.id === bk.packageId);
        const gal = snap.galleries.find((g) => g.bookingId === bk.id);
        const crews = snap.crewAssignments.filter((c) => c.bookingId === bk.id);

        return (
          <div class="bg-white border border-black/15 p-6 space-y-5">
            <div class="flex flex-wrap items-start justify-between gap-4 border-b border-black/10 pb-4">
              <div class="space-y-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="font-mono text-xs font-semibold bg-[#181817] text-white px-2.5 py-0.5">
                    {bk.bookingCode}
                  </span>
                  <span class="eyebrow-label text-[#5e5d59]">{pkg?.name}</span>
                  {!bk.allowPortfolioPublish ? (
                    <span class="bg-red-800 text-white text-[10px] font-bold uppercase px-2.5 py-0.5">
                      🔒 PRIVATE SESSION — DILARANG PUBLIKASI
                    </span>
                  ) : (
                    <span class="bg-emerald-50 text-emerald-900 border border-emerald-200 text-[10px] font-semibold uppercase px-2 py-0.5">
                      Portofolio Diizinkan
                    </span>
                  )}
                </div>
                <h2 class="text-xl font-normal">{bk.eventTitle}</h2>
                <p class="text-xs text-[#5e5d59]">
                  {bk.clientName} ({bk.clientPhone}) • {formatShortDate(bk.eventDate)} ({bk.startTime}–{bk.endTime} WIB)
                  • {bk.venueName}, {bk.venueCity}
                </p>
              </div>

              <div class="text-right space-y-1">
                <p class="text-lg font-semibold tabular-nums">{formatRupiah(bk.grandTotal)}</p>
                <p class="text-xs text-[#5e5d59]">
                  Terbayar: <strong class="text-[#121212]">{formatRupiah(bk.paidAmount)}</strong> ({bk.paymentStatus})
                </p>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs bg-[#f6f4ef] p-4 border border-black/8">
              <div>
                <span class="text-[10px] uppercase tracking-wider text-[#5e5d59] block">Kontrak Digital S&K</span>
                <strong>{bk.termsVersionCode}</strong> • Ditandatangani {bk.signedAt} (IP: {bk.signedIp})
              </div>
              <div>
                <span class="text-[10px] uppercase tracking-wider text-[#5e5d59] block">Status Tahap Project</span>
                <strong>{bk.projectStatus}</strong>
              </div>
              <div class="flex items-center gap-3 md:justify-end">
                <a href={`/portal/${bk.bookingCode}`} class="underline font-semibold">
                  Portal Klien ↗
                </a>
                {gal && (
                  <a href={`/galeri/${gal.slug}?pin=${gal.clientPin}`} class="underline font-semibold">
                    Galeri (PIN {gal.clientPin}) ↗
                  </a>
                )}
              </div>
            </div>

            {/* Assigned Crew & RAW Verification */}
            <div class="space-y-2.5">
              <p class="text-[10px] uppercase tracking-[0.14em] font-semibold text-[#5e5d59]">
                Tim Freelance Bertugas & Verifikasi Serah Terima RAW ({crews.length} Kru)
              </p>

              {crews.length === 0 ? (
                <p class="text-xs text-amber-900 bg-amber-50 border border-amber-200 p-3">
                  ⚠ Belum ada kru lapangan yang ditugaskan.{' '}
                  <a href="/admin/crew" class="underline font-semibold">
                    Tugaskan di menu Crew Freelance →
                  </a>
                </p>
              ) : (
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
                  {crews.map((ca) => {
                    const fr = snap.freelancers.find((f) => f.id === ca.freelancerId);
                    return (
                      <div class="p-3.5 border border-black/12 flex items-center justify-between gap-3">
                        <div>
                          <p class="font-semibold">
                            {fr?.name} — <span class="text-[#5e5d59]">{ca.roleTitle}</span>
                          </p>
                          <p class="text-[11px] text-[#5e5d59]">
                            Offer: {ca.offerStatus} • RAW: <strong>{ca.rawStatus}</strong> • Fee:{' '}
                            {formatRupiah(ca.feeAmount + ca.transportAllowance)}
                          </p>
                          {ca.rawStorageNote && <p class="text-[11px] text-[#121212] mt-0.5">{ca.rawStorageNote}</p>}
                        </div>

                        {ca.rawStatus !== 'VERIFIED' ? (
                          <form method="POST" action="/api/actions">
                            <input type="hidden" name="action" value="admin_verify_raw" />
                            <input type="hidden" name="assignmentId" value={ca.id} />
                            <input type="hidden" name="redirectTo" value="/admin/bookings" />
                            <button type="submit" class="btn-sq-black !py-2 !px-3 !text-[10px] shrink-0 cursor-pointer">
                              Verify RAW
                            </button>
                          </form>
                        ) : (
                          <span class="px-2.5 py-1 bg-emerald-100 text-emerald-900 text-[10px] font-semibold uppercase">
                            ✓ RAW Aman
                          </span>
                        )}
                      </div>
                    );
                  })}
                </div>
              )}
            </div>
          </div>
        );
      })
    }
  </div>
</BackofficeLayout>
