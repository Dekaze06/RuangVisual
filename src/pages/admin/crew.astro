---
import BackofficeLayout from '../../layouts/BackofficeLayout.astro';
import { getFullStudioSnapshot } from '../../lib/analytics';
import { formatRupiah, formatShortDate } from '../../lib/format';

const snap = await getFullStudioSnapshot();
---

<BackofficeLayout
  title="Penugasan Crew Freelance & Inventaris Gear Studio"
  subtitle="Dispatch fotografer, videografer, dan pilot drone ke jadwal acara serta kendalikan peminjaman alat milik studio."
  activeNav="crew-admin"
>
  <!-- Dispatch Crew Form -->
  <div class="bg-white border border-black/15 p-6 space-y-5">
    <div class="border-b border-black/10 pb-3">
      <p class="eyebrow-label text-[#5e5d59]">Job Dispatch System</p>
      <h2 class="text-lg font-medium mt-0.5">Tugaskan Freelancer ke Jadwal Acara</h2>
      <p class="text-xs text-[#5e5d59]">
        Sistem otomatis memvalidasi kalender tanggal <em>Blocked</em> masing-masing freelancer sebelum mengirim tawaran.
      </p>
    </div>

    <form method="POST" action="/api/actions" class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end text-xs">
      <input type="hidden" name="action" value="admin_assign_crew" />
      <input type="hidden" name="redirectTo" value="/admin/crew" />

      <div class="md:col-span-3">
        <label class="block font-semibold mb-1">Pilih Project / Booking</label>
        <select name="bookingId" class="w-full px-3 py-2.5 border border-black/20 bg-white">
          {
            snap.bookings.map((b) => (
              <option value={b.id}>
                {b.bookingCode} — {b.clientName} ({formatShortDate(b.eventDate)})
              </option>
            ))
          }
        </select>
      </div>

      <div class="md:col-span-3">
        <label class="block font-semibold mb-1">Pilih Talenta Freelance</label>
        <select name="freelancerId" class="w-full px-3 py-2.5 border border-black/20 bg-white">
          {
            snap.freelancers.map((f) => (
              <option value={f.id}>
                {f.name} ({f.primaryRole} • {formatRupiah(f.defaultFee)})
              </option>
            ))
          }
        </select>
      </div>

      <div class="md:col-span-2">
        <label class="block font-semibold mb-1">Peran di Lokasi</label>
        <input
          type="text"
          name="roleTitle"
          placeholder="Lead Photographer"
          required
          class="w-full px-3 py-2.5 border border-black/20"
        />
      </div>

      <div class="md:col-span-2">
        <label class="block font-semibold mb-1">Fee Kru (IDR)</label>
        <input type="number" name="feeAmount" value="1250000" required class="w-full px-3 py-2.5 border border-black/20" />
      </div>

      <div class="md:col-span-2">
        <button type="submit" class="btn-sq-black w-full !py-2.5 !px-3 cursor-pointer">
          Kirim Tawaran →
        </button>
      </div>
    </form>
  </div>

  <!-- Freelancer Talent Directory & Studio Gear Loan -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <div class="lg:col-span-7 space-y-4">
      <h2 class="text-lg font-medium">Database Talenta Crew Freelance ({snap.freelancers.length} Orang)</h2>
      <div class="space-y-4">
        {
          snap.freelancers.map((fr) => {
            const blocked: string[] = JSON.parse(fr.blockedDatesJson || '[]');
            return (
              <div class="bg-white border border-black/15 p-5 space-y-3 text-xs">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="font-semibold text-sm">{fr.name}</span>
                      <span class="px-2 py-0.5 bg-[#181817] text-white text-[10px] uppercase">{fr.grade}</span>
                      <span class="text-[#5e5d59]">★ {fr.rating}</span>
                    </div>
                    <p class="text-[#5e5d59] mt-0.5">
                      {fr.specialties} • Domisili: {fr.city} • WA: {fr.phone}
                    </p>
                  </div>
                  <div class="text-right">
                    <p class="font-semibold tabular-nums">{formatRupiah(fr.defaultFee)} / Sesi</p>
                    <p class="text-[11px] text-[#5e5d59]">
                      {fr.bankName} {fr.bankAccountNo}
                    </p>
                  </div>
                </div>
                <p class="bg-[#f6f4ef] p-2.5 border border-black/8">
                  <strong>Inventaris Pribadi:</strong> {fr.gearList}
                </p>
                {blocked.length > 0 && (
                  <p class="text-[11px] text-red-800">
                    Tanggal Blocked: <strong>{blocked.map((d) => formatShortDate(d)).join(', ')}</strong>
                  </p>
                )}
              </div>
            );
          })
        }
      </div>
    </div>

    <!-- Studio Gear Loan Check-out / Check-in -->
    <div class="lg:col-span-5 bg-white border border-black/15 p-6 space-y-4">
      <div class="border-b border-black/10 pb-3">
        <p class="eyebrow-label text-[#5e5d59]">Studio Asset Control</p>
        <h2 class="text-lg font-medium mt-0.5">Peminjaman Kamera, Drone & Alat Studio</h2>
      </div>

      <div class="space-y-3 text-xs">
        {
          snap.studioGears.map((gr) => (
            <div class="p-4 border border-black/12 bg-[#fbfaf7] space-y-2.5">
              <div class="flex items-start justify-between gap-2">
                <div>
                  <span class="font-mono text-[10px] text-[#5e5d59]">{gr.gearCode}</span>
                  <p class="font-semibold text-sm">{gr.name}</p>
                  <p class="text-[11px] text-[#5e5d59]">Nilai Aset: {formatRupiah(gr.purchaseValue)}</p>
                </div>
                <span
                  class:list={[
                    'px-2 py-0.5 text-[10px] font-semibold uppercase',
                    gr.conditionStatus === 'READY_IN_STUDIO'
                      ? 'bg-emerald-100 text-emerald-900'
                      : 'bg-amber-100 text-amber-900',
                  ]}
                >
                  {gr.conditionStatus === 'READY_IN_STUDIO' ? 'Di Studio' : 'Dipinjam'}
                </span>
              </div>

              {gr.conditionStatus === 'ON_LOAN' ? (
                <div class="flex items-center justify-between pt-2 border-t border-black/10">
                  <span class="text-[11px]">
                    Dibawa oleh: <strong>{gr.borrowedByCrew}</strong> ({gr.borrowedBookingCode})
                  </span>
                  <form method="POST" action="/api/actions">
                    <input type="hidden" name="action" value="toggle_gear_loan" />
                    <input type="hidden" name="gearId" value={gr.id} />
                    <input type="hidden" name="redirectTo" value="/admin/crew" />
                    <button type="submit" class="btn-sq-black !py-1.5 !px-3 !text-[10px] cursor-pointer">
                      Kembalikan ke Studio
                    </button>
                  </form>
                </div>
              ) : (
                <form method="POST" action="/api/actions" class="flex gap-2 pt-2 border-t border-black/10">
                  <input type="hidden" name="action" value="toggle_gear_loan" />
                  <input type="hidden" name="gearId" value={gr.id} />
                  <input type="hidden" name="redirectTo" value="/admin/crew" />
                  <input
                    type="text"
                    name="borrowedByCrew"
                    placeholder="Nama kru peminjam..."
                    required
                    class="flex-1 px-2.5 py-1.5 bg-white border border-black/20"
                  />
                  <button type="submit" class="btn-sq-outline-dark !py-1.5 !px-3 !text-[10px] cursor-pointer">
                    Pinjamkan
                  </button>
                </form>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</BackofficeLayout>
