  <script is:inline>
    // Interactive Category Switcher
    const catBtns = document.querySelectorAll('[data-cat-btn]');
    const catPanels = document.querySelectorAll('[data-cat-panel]');
    catBtns.forEach((btn) => {
      const activate = () => {
        const target = btn.getAttribute('data-cat-btn');
        catBtns.forEach((b) => {
          const active = b.getAttribute('data-cat-btn') === target;
          b.classList.toggle('text-[#121212]', active);
          b.classList.toggle('font-medium', active);
          b.classList.toggle('text-[#8c8b85]', !active);
          const arrow = b.querySelector('.cat-arrow');
          if (arrow) arrow.classList.toggle('opacity-100', active);
          if (arrow) arrow.classList.toggle('opacity-0', !active);
        });
        catPanels.forEach((p) => {
          p.classList.toggle('hidden', p.getAttribute('data-cat-panel') !== target);
        });
      };
      btn.addEventListener('click', activate);
      btn.addEventListener('mouseenter', activate);
    });

    // Portfolio Horizontal Carousel Controls
    const strip = document.getElementById('portfolio-strip');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');
    if (strip && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => strip.scrollBy({ left: -420, behavior: 'smooth' }));
      nextBtn.addEventListener('click', () => strip.scrollBy({ left: 420, behavior: 'smooth' }));
    }
  </script>
